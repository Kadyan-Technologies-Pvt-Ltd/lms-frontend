# Copy to .env.local for local overrides, or set in your static host's build
# settings for production.

# Base URL the app sends API requests to.
#
# Leave EMPTY for local development and for any deployment where the frontend
# and API share an origin — the app then uses the relative "/api/v1", which
# Vite's dev proxy (see vite.config.ts) forwards to the backend.
#
# Set it ONLY when the frontend is hosted separately from the API, to the
# API's absolute base including /api/v1, e.g.
#   VITE_API_BASE_URL=https://api.thedigitalib.com/api/v1
#
# Vite inlines this at BUILD time, not runtime — changing it means rebuilding
# and redeploying, not just restarting.
VITE_API_BASE_URL=
